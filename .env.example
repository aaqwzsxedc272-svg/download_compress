# Copy to .env (it is gitignored) and the server reads it on every start.
# Nothing here is required: without mail, the app offers a mailto: link instead.
# You can also fill these in on the page — that saves them to data/mail.json,
# which survives restarts and beats these values.

# --- mail the share links (Gmail app password, not the account password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
NOTIFY_EMAIL=aaqwzsxedc272@gmail.com
# AUTO_EMAIL=0            # stop mailing automatically when the queue drains

# --- space ---
# KEEP_LOCAL_AFTER_UPLOAD=1   # keep the compressed file after it is hosted

# --- deployment ---
# PORT=3000
# DATA_DIR=./data
