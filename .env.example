# Copy to .env (it is gitignored) and the server reads it on every start.
# Nothing here is required: without mail, the app offers a mailto: link instead.
# You can also fill these in on the page — that saves them to data/mail.json,
# which survives restarts and beats these values.

# --- mail the share links (Gmail app password, not the account password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
NOTIFY_EMAIL=aaqwzsxedc272@gmail.com
# AUTO_EMAIL=0            # stop mailing automatically when the queue drains

# --- space ---
# KEEP_LOCAL_AFTER_UPLOAD=1   # keep the compressed file after it is hosted

# --- deployment ---
# PORT=3000
# DATA_DIR=./data

# --- post the share links somewhere, with no app password ---
# Tried in this order, first one that works wins. AUTO_PUBLISH=0 turns it off;
# the console, the page and data/links.tsv always have the links regardless.
#
# A GitHub gist, updated in place (stable URL). In a Codespace `gh` is already
# logged in, so this usually needs nothing at all:
# (no variable — it is tried automatically)
#
# A webhook: Discord, Slack, n8n, anything that takes JSON.
# PUBLISH_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
#
# A push notification, no account: pick a hard-to-guess topic, subscribe in the
# ntfy app or at https://ntfy.sh/<topic>
# PUBLISH_NTFY=squeeze-7f3k2p
#
# Commit LINKS.md to this repository and push it (visible on GitHub anywhere).
# PUBLISH_REPO=1
#
# An anonymous paste that returns a URL (the links become public).
# PUBLISH_PASTE=1
